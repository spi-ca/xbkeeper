pkgname=xbkeeper
pkgver=0.2.0
pkgrel=1
pkgdesc='Small local full-backup and retention manager for Percona XtraBackup'
arch=('x86_64' 'aarch64')
license=('BSD-3-Clause')
depends=('xtrabackup')
makedepends=('go>=1.24')
options=('!lto')
# Local source distribution generated with `make dist` at the repository root.
# No public upstream URL is assumed before this repository is published.
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('d5c9cc2ba4753fb94996c220298d678c7ba33499000725ab7c5cd612dcd2ad20')

build() {
  cd "${pkgname}-${pkgver}"
  CGO_ENABLED=0 go build -trimpath -buildvcs=false \
    -ldflags "-X main.Version=${pkgver}" -o xbkeeper .
}

check() {
  cd "${pkgname}-${pkgver}"
  go test ./...
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 xbkeeper "${pkgdir}/usr/bin/xbkeeper"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 docs/integrity.md "${pkgdir}/usr/share/doc/${pkgname}/docs/integrity.md"
  install -Dm644 packaging/arch/README.md \
    "${pkgdir}/usr/share/doc/${pkgname}/packaging/arch/README.md"
}
